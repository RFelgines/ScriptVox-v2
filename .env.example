# ─── LLM Provider ────────────────────────────────────────────────────────────
# Quick start — pick ONE path:
#   • Fastest:    set LLM_PROVIDER=gemini and fill GEMINI_API_KEY below (just a key).
#   • Fully local: keep LLM_PROVIDER=ollama and install Ollama + pull the model
#                  (see README "Quick start"; `python scripts/doctor.py` tells you what's missing).
# Which LLM backend to use: ollama (local) | gemini (cloud) | openai_compatible (any server
# exposing the OpenAI API: LM Studio, llama.cpp, vLLM, OpenRouter…) | the name of a plugin
# dropped in plugins/llm/ (see docs/PLUGINS.md).
# The model can ALSO be changed at any time from the Settings page (any name is accepted,
# even one that is not in the suggestion list) — values set there take priority over this file.
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
# qwen3:1.7b + think=False (natif, plus fiable que l'ancien suffixe /no_think) + les
# réparations d'attribution de _parse_llm_json battent qwen3:8b en vitesse ET en
# qualité sur un run HP complet mesuré (spike 2026-07-02) : 79% d'attribution en
# ~9 min contre 76% en ~24 min pour qwen3:8b. Voir ARCHITECTURE.md §2.7 / §2.5.
OLLAMA_MODEL=qwen3:1.7b
# 32768 tient 100% en VRAM avec qwen3:1.7b (poids ~1.4 Go) — contexte plein disponible,
# contrairement à qwen3:8b qui débordait sur le CPU à cette taille.
OLLAMA_CONTEXT_TOKENS=32768
# Budget de découpe d'un chapitre en chunks (tokens), découplé du contexte ci-dessus.
# Réglé pour qu'un chapitre HP tienne en un seul chunk (mesure validée) : découper
# inutilement fragmente la liste de personnages entre appels et peut dégrader
# l'attribution. Sur un modèle avec moins de marge VRAM, réduire au besoin.
OLLAMA_CHUNK_TOKENS=26000
OLLAMA_CONNECT_TIMEOUT=60
# Per-request read timeout = floor + (estimated prompt tokens / 1000) * per-1k-tokens.
# Floor covers small/medium chapters; the per-token term scales up for dense chapters
# and/or a slow/CPU-offloaded local model (see ARCHITECTURE.md §2.5).
OLLAMA_READ_TIMEOUT=600
OLLAMA_TIMEOUT_PER_1K_TOKENS=200

# Gemini settings (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-2.0-flash was shut down on 2026-06-01 and gemini-2.5-flash stops on 2026-10-16:
# use a current model (list them in Settings, or `client.models.list()`).
GEMINI_MODEL=gemini-3.1-flash-lite

# Any OpenAI-compatible server (LM Studio default port shown). Used when
# LLM_PROVIDER=openai_compatible — this is the easy way to run ANY model (e.g. a Qwen 3.8
# GGUF served by llama-server or LM Studio) without dedicated code.
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_MODEL=
# Leave empty for local servers that need no key.
OPENAI_API_KEY=
# Chunk budget (tokens) per request, and request timeout (seconds).
OPENAI_CHUNK_TOKENS=12000
OPENAI_TIMEOUT=900

# Sampling temperature for analysis (low = consistent attributions).
LLM_TEMPERATURE=0.2
# Free the local LLM's VRAM (Ollama keep_alive=0) at the end of the analysis, so a local GPU TTS
# can load. Set to false if you have plenty of VRAM and re-analyse often.
LLM_UNLOAD_AFTER_ANALYSIS=true

# ─── TTS Provider ────────────────────────────────────────────────────────────
# Which TTS backend to use: edgetts (default, free, no key) | piper (local, offline) |
# qwen (local, GPU, emotion per line — requires requirements-qwen.txt) |
# openai_tts (any server exposing POST /v1/audio/speech) | command (any external program) |
# the name of a plugin dropped in plugins/tts/ (see docs/PLUGINS.md).
TTS_PROVIDER=edgetts

# EdgeTTS settings (used when TTS_PROVIDER=edgetts)
# BCP-47 locale — controls which neural voices are selected (en-US, fr-FR, de-DE, …).
# A book's own language (from its EPUB metadata) takes priority over this default.
EDGETTS_LOCALE=fr-FR
# Optional JSON override of the logical-voice -> EdgeTTS-voice table, e.g.
# {"male_1": "fr-CA-JeanNeural", "narrator": {"voice": "fr-FR-HenriNeural", "rate": "-5%"}}
# EDGETTS_VOICE_MAP=

# Piper settings (used when TTS_PROVIDER=piper)
PIPER_VOICES_DIR=./voices
# Path to the piper executable (download from github.com/rhasspy/piper/releases)
PIPER_BINARY_PATH=./piper/piper.exe

# Qwen3-TTS settings (used when TTS_PROVIDER=qwen — requires `pip install -r requirements-qwen.txt`)
# Model: 1.7b (~4-6 GB VRAM, better quality) | 0.6b (smaller, faster) | ANY Hugging Face id or
# local path of a compatible CustomVoice checkpoint (e.g. MyOrg/my-finetune).
QWEN_MODEL=1.7b
# Checkpoint used for voice cloning when QWEN_MODEL is a custom id (default: 1.7B-Base).
# QWEN_BASE_MODEL=
# Optional JSON override of the logical-voice -> Qwen speaker table (for a checkpoint whose
# presets differ), e.g. {"narrator": "MySpeaker"}
# QWEN_VOICE_MAP=
# Language passed to generate_custom_voice (e.g. French, English)
QWEN_LANGUAGE=French
# torch device string
QWEN_DEVICE=cuda:0
# Attention implementation: sdpa (no FlashAttention 2, recommended on Windows and REQUIRED on
# AMD GPUs) | flash_attention_2
# AMD Radeon: install PyTorch for ROCm (see README "AMD GPUs"); the device string stays cuda:0.
# If the driver resets during generation on an RX 9000: set TORCH_BLAS_PREFER_HIPBLASLT=0.
QWEN_ATTN=sdpa

# Generic TTS: any server exposing POST {TTS_HTTP_BASE_URL}/audio/speech (OpenAI Audio API).
# Used when TTS_PROVIDER=openai_tts. Model and address can also be changed in Settings.
TTS_HTTP_BASE_URL=http://localhost:8880/v1
TTS_HTTP_MODEL=tts-1
TTS_HTTP_API_KEY=
# JSON: logical voice id -> the server's voice name ("default" = any unmapped id), e.g.
# {"narrator": "ff_siwis", "male_0": "am_adam", "default": "ff_siwis"}
TTS_HTTP_VOICE_MAP=
# JSON merged into every request body (speed, language…), e.g. {"speed": 0.95}
TTS_HTTP_EXTRA_BODY=
# Body field that receives the per-line emotion (leave empty if the server has none).
TTS_HTTP_EMOTION_FIELD=
# Simultaneous requests (1 = sequential; raise it for a cloud/API server).
TTS_HTTP_CONCURRENCY=1

# Generic TTS: any external program. Used when TTS_PROVIDER=command. This can ONLY be set here
# (never from the web interface). No shell is involved: the text can never inject commands.
# Placeholders: {text_file} {text} {out} {voice} {emotion} {ref} {language}. Without {out} the
# program must write its audio to stdout. Output may be WAV/MP3/FLAC/OGG at any sample rate.
# TTS_COMMAND=python C:/tts/run.py --in {text_file} --out {out} --voice {voice} --lang {language}
TTS_COMMAND_TIMEOUT=300
# TTS_COMMAND_VOICE_MAP={"narrator": "voice_a", "default": "voice_b"}

# ─── Audio assembly ──────────────────────────────────────────────────────────
# Silence (ms) after a line when the same voice continues / when the voice changes, and between
# chapters. Set to 0 to disable.
AUDIO_PAUSE_SAME_VOICE_MS=250
AUDIO_PAUSE_VOICE_CHANGE_MS=450
AUDIO_PAUSE_CHAPTER_MS=1500
# Even out the loudness of segments coming from different voices/engines (bounded ±6 dB gain).
AUDIO_NORMALIZE=true
# Long texts are split at sentence ends before synthesis. 0 = each engine's own limit.
TTS_MAX_CHARS=0
# 0 = each engine's own value (EdgeTTS 6, local GPU 1). Force a value for all engines.
TTS_CONCURRENCY=0
# Seconds of inactivity before a GPU TTS model kept in memory is unloaded (0 = never).
TTS_IDLE_UNLOAD_SECONDS=300
# ffmpeg is used to export the chaptered M4B audiobook. Found on PATH by default; set this only
# if it lives elsewhere. Without ffmpeg the MP3 is still produced.
# FFMPEG_PATH=

# ─── Plugins ─────────────────────────────────────────────────────────────────
# Folder scanned for your own LLM/TTS engines (plugins/llm/*.py, plugins/tts/*.py).
# See docs/PLUGINS.md. Relative paths are relative to the project root.
PLUGINS_DIR=plugins

# ─── Frontend / CORS ─────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. Also the ONLY origins allowed to
# write (POST/PATCH/DELETE) — the API refuses cross-site writes.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Host names accepted in the Host header (defends against DNS rebinding). The default
# (localhost, 127.0.0.1) is right for normal use: uncomment and extend it only if you reach the
# API through another hostname.
# ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./scriptvox.db
HUEY_DB_PATH=./huey.db
# Dossier de stockage des fichiers (couvertures, audio, voix clonées). Obligatoire
# (pas de défaut silencieux) : chaque tests/check_phaseN.py DOIT pointer vers un
# dossier isolé (ex. ./data_test), jamais ce chemin réel — incident 2026-07-02 où
# des tests ont écrasé de vraies couvertures/audio via un chemin codé en dur.
DATA_DIR=data
